SITE_ADDRESS=https://translate.example.com
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_MODEL=deepseek-v4-pro
PROMPT_VERSION=df-zh-hans-v2
UPSTREAM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
UPSTREAM_TIMEOUT_MS=30000
MAX_UPSTREAM_CONCURRENCY=8
MAX_TEXT_LENGTH=4000
CLIENT_HEADER_VALUE=dfi18n-runtime-v1
DATABASE_PATH=/data/translations.sqlite3
PORT=3000
